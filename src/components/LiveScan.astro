<section id="live-scan" aria-labelledby="live-scan-title">
  <h2 id="live-scan-title">Scan an LLM response</h2>
  <label for="live-text">Text to scan</label>
  <textarea id="live-text" class="sandbox__text" rows="5" spellcheck="false" autocomplete="off" aria-describedby="scan-note"></textarea>
  <p id="scan-note">Scan sends this text to StegGuard to check Unicode characters and whitespace. Limit 32 KiB of UTF-8 text.</p>
  <button id="scan-submit" class="btn btn--solid" type="button" disabled>Scan with StegGuard</button>
  <noscript>Enable JavaScript to submit a scan.</noscript>
  <p id="scan-status" role="status"></p>
  <ul id="scan-findings"></ul>
</section>
<script>
  const root = document.querySelector("#live-scan");
  if (root) {
    const input = root.querySelector("textarea")!;
    const submit = root.querySelector("button")!;
    const status = root.querySelector("#scan-status")!;
    const findings = root.querySelector("ul")!;
    const limit = 32768;
    const encoder = new TextEncoder();
    const tooLarge = (text: string) => text.length > limit || encoder.encode(text).length > limit;
    let previous = "";
    let active: AbortController | undefined;

    input.addEventListener("input", () => {
      active?.abort();
      active = undefined;
      findings.replaceChildren();
      if (tooLarge(input.value)) {
        input.value = previous;
        status.textContent = "Edit rejected. The limit is 32 KiB. Your previous text is still in the field.";
      } else {
        previous = input.value;
        status.textContent = "";
      }
      submit.disabled = !input.value;
    });

    submit.addEventListener("click", async () => {
      if (active || !input.value || tooLarge(input.value)) return;
      const controller = new AbortController();
      active = controller;
      submit.disabled = true;
      findings.replaceChildren();
      status.textContent = "Scanning…";
      const timeout = window.setTimeout(() => controller.abort(), 10000);
      try {
        const response = await fetch("/api/scan", {
          method: "POST", body: input.value, credentials: "omit", redirect: "error",
          cache: "no-store", signal: controller.signal,
          headers: { "Content-Type": "text/plain;charset=utf-8", "X-Stegguard-Scan": "1" },
        });
        if (!response.ok) {
          const reasons: Record<number, string> = {
            413: "Text exceeds 32 KiB.", 422: "This input contains unsupported text.",
            429: "Too many scans. Try again shortly.",
          };
          throw new Error(reasons[response.status] ?? "Scan unavailable. Try again later.");
        }
        const report = await response.json();
        if (active !== controller) return;
        if (typeof report.complete !== "boolean" || !Array.isArray(report.findings) ||
            report.findings.length > 101 || !report.findings.every((f: unknown) => typeof f === "string")) {
          throw new Error("Unexpected scan response.");
        }
        for (const finding of report.findings) {
          const item = document.createElement("li");
          item.textContent = finding;
          findings.append(item);
        }
        status.textContent = !report.complete ? "Scan incomplete. Findings are limited to the entries shown."
          : report.findings.length ? `Scan complete. Findings: ${report.findings.length}.`
          : "Scan complete. No matching Unicode or whitespace findings.";
      } catch (error) {
        if (active === controller) status.textContent = controller.signal.aborted
          ? "Scan timed out." : error instanceof Error ? error.message : "Scan unavailable.";
      } finally {
        window.clearTimeout(timeout);
        if (active === controller) {
          active = undefined;
          submit.disabled = !input.value;
        }
      }
    });
  }
</script>
