<section id="live-scan" aria-labelledby="live-scan-title">
  <h1 id="live-scan-title">Scan your text</h1>
  <label class="sandbox__label" for="live-text">Paste text or an LLM response</label>
  <textarea id="live-text" class="sandbox__text" rows="5" spellcheck="false" autocomplete="off" aria-describedby="scan-note"></textarea>
  <p id="scan-note">StegGuard checks Unicode characters and whitespace in your browser. Your text stays on this device. Limit 32 KiB.</p>
  <button id="scan-submit" class="btn btn--solid" type="button" disabled>Scan with StegGuard</button>
  <noscript>Enable JavaScript to run a scan.</noscript>
  <p id="scan-status" role="status"></p>
  <ul id="scan-findings"></ul>
</section>
<script>
  const root = document.querySelector("#live-scan");
  if (root) {
    const input = root.querySelector("textarea")!;
    const submit = root.querySelector("button")!;
    const status = root.querySelector("#scan-status")!;
    const findings = root.querySelector("ul")!;
    const limit = 32768;
    const encoder = new TextEncoder();
    const tooLarge = (text: string) => text.length > limit || encoder.encode(text).length > limit;
    let previous = "";
    let active: Worker | undefined;
    let timeout: number | undefined;

    function stop() {
      window.clearTimeout(timeout);
      active?.terminate();
      active = undefined;
      submit.disabled = !input.value;
    }

    input.addEventListener("input", () => {
      stop();
      findings.replaceChildren();
      if (tooLarge(input.value)) {
        input.value = previous;
        status.textContent = "Edit rejected. The limit is 32 KiB. Your previous text is still in the field.";
      } else {
        previous = input.value;
        status.textContent = "";
      }
      submit.disabled = !input.value;
    });

    submit.addEventListener("click", () => {
      if (active || !input.value || tooLarge(input.value)) return;
      submit.disabled = true;
      findings.replaceChildren();
      status.textContent = "Loading the local scanner…";
      try {
        const worker = new Worker("/scan-worker.js");
        active = worker;
        timeout = window.setTimeout(() => {
          stop();
          status.textContent = "The local scan timed out. Try again.";
        }, 60000);
        worker.onerror = () => {
          if (active !== worker) return;
          stop();
          status.textContent = "Could not start the local scanner.";
        };
        worker.onmessage = ({ data }) => {
          if (active !== worker) return;
          stop();
          if (data.failed || data.unsupported) {
            status.textContent = data.unsupported ? "This text contains unsupported characters." : "Could not load or run the local scanner.";
            return;
          }
          for (const finding of data.findings) {
            const item = document.createElement("li");
            item.textContent = finding;
            findings.append(item);
          }
          status.textContent = !data.complete ? "Scan incomplete. The findings limit was reached."
            : data.findings.length ? `Scan complete. Findings: ${data.findings.length}.`
            : "Scan complete. No matching Unicode or whitespace findings.";
        };
        worker.postMessage(input.value);
      } catch {
        stop();
        status.textContent = "Could not start the local scanner.";
      }
    });
  }
</script>
