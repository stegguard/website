---
import Layout from "../layouts/Layout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Sandbox from "../components/Sandbox.astro";
import Integrations from "../components/Integrations.astro";
import demo from "../data/demo.json";
import { countWord } from "../lib/words";
import { pipInstall, RELEASE, PYPI_URL } from "../lib/install";

const installCmd = pipInstall();

// Lines are trimmed excerpts of real CLI output from a run on that file.
const steps = [
  {
    verb: "Detect",
    title: "Point it at a file or a whole repo.",
    caption: "Runs on the standard library, with no network calls. It exits with 1 when something is flagged, so CI can fail the build.",
    lines: [
      { t: "cmd", s: "$ stegguard detect report.md" },
      { t: "out", s: "  • 16 zero-width characters found" },
      { t: "out", s: "  • 1 suspicious control character(s) found" },
      { t: "hit", s: "⚠ 1/1 file(s) flagged" },
    ],
  },
  {
    verb: "Decode",
    title: "Read the hidden message without touching the file.",
    caption: "The result is JSON, with a confidence score for each channel.",
    lines: [
      { t: "cmd", s: "$ stegguard decode report.md" },
      { t: "hit", s: '  "decoded": "hi",' },
      { t: "out", s: '  "confidence": 0.9,' },
      { t: "out", s: '  "occurrences": 16' },
    ],
  },
  {
    verb: "Sanitize",
    title: "Get a clean copy and a record of what changed.",
    caption: "The copy goes to report.sanitized.md by default. Overwriting the original takes --in-place and --confirm together.",
    lines: [
      { t: "cmd", s: "$ stegguard sanitize report.md" },
      { t: "out", s: '  "zero_width_removed": 16,' },
      { t: "out", s: '  "bidi_removed": 1,' },
      { t: "hit", s: '  "original_preserved": true' },
    ],
  },
] as const;

const specs = [
  {
    id: "text",
    name: "Text and source",
    detail: "Zero-width Unicode, bidirectional overrides, Cyrillic and Greek homoglyphs, trailing-space and tab channels, mixed line endings.",
    href: "/docs#commands",
  },
  {
    id: "media",
    name: "Images, audio and media",
    detail: "Pixel-level LSB anomalies (chi-square, RS, entropy, sample-pair), PNG private chunks, JPEG EXIF/XMP/IPTC, PCM audio statistics.",
    href: "/docs#commands",
  },
  {
    id: "documents",
    name: "Documents and containers",
    detail: "PDF embedded files, DOCX/PPTX/XLSX/ZIP members, nested archives, hidden content in SVG and HTML.",
    href: "/docs#limits",
  },
  {
    id: "watermarks",
    name: "Watermarks and provenance",
    detail: "Metadata, structural and text-pattern evidence, device fingerprints, and C2PA manifests validated through c2patool.",
    href: "/docs#commands",
  },
];

// Pixels of the 10x4 media sketch that are drawn as "found".
const foundCells = new Set([3, 12, 17, 26, 34]);

const useCases = [
  { label: "CI gate", body: "Fail a pull request that adds BIDI overrides or homoglyphs to source files." },
  { label: "LLM input checks", body: "Look for zero-width prompt injection in pasted text and scraped pages before they reach a model." },
  { label: "Pre-publish checks", body: "Scan DOCX, PPTX and PDF files for hidden content before you send them out." },
  { label: "Provenance audits", body: "Validate C2PA Content Credentials and look for watermark signals before you trust an image or audio file." },
];
---

<Layout>
  <main id="content">
    <section class="hero wrap">
      <div class="hero__intro">
        <div>
          <p class="eyebrow">Open source · <a href={PYPI_URL}>v{RELEASE} on PyPI</a> · Apache-2.0 · alpha</p>
          <h1>Your text has characters you can't see.</h1>
          <p class="lede">
            StegGuard finds them. It scans files for zero-width characters, homoglyphs, whitespace
            channels and watermark signals. If it finds a hidden message it can decode it, and it
            writes a clean copy without touching your original. Python standard library only, offline
            by default.
          </p>
        </div>
        <img class="hero__banner" src="/images/steg_banner.png" alt="StegGuard logo: a stag inside a magnifying glass held over binary digits, captioned 'Uncovering hidden data'" width="630" height="276" fetchpriority="high" />
      </div>

      <Sandbox />

      <div class="hero__install">
        <CodeBlock label="shell" copy={installCmd} lines={[{ t: "cmd", s: installCmd }]} />
        <p class="hero__more"><a href="/demo">See it run on {countWord(demo.total_files)} sample files</a> · <a href="/docs">CLI reference</a></p>
      </div>
    </section>

    <section class="steps wrap" id="how-it-works" aria-labelledby="steps-h">
      <h2 id="steps-h">One workflow instead of several one-off tools.</h2>
      <p class="section-lede">Detect, decode, then sanitize a copy. Your original stays as it is unless you ask for an in-place rewrite.</p>
      <ol class="steps__list">
        {steps.map((step, i) => (
          <li class="step" id={step.verb.toLowerCase()}>
            <div class="step__text">
              <p class="step__num">0{i + 1} · {step.verb}</p>
              <h3>{step.title}</h3>
              <p>{step.caption.split(/(--[a-z-]+|report\.sanitized\.md)/).map((part, j) => j % 2 ? <code>{part}</code> : part)}</p>
            </div>
            <CodeBlock label={`stegguard ${step.verb.toLowerCase()}`} lines={[...step.lines]} />
          </li>
        ))}
      </ol>
    </section>

    <Integrations />

    <section class="wrap" id="detects" aria-labelledby="detects-h">
      <h2 id="detects-h">Hidden content rarely comes in one neat format.</h2>
      <div class="caps">
        {specs.map((c) => (
          <article class="cap">
            <div class="cap__visual" aria-hidden="true">
              {c.id === "text" && <p class="cap__text">p<mark class="cap__found">{"а"}</mark>ypal.com</p>}
              {c.id === "media" && (
                <div class="cap__grid">
                  {Array.from({ length: 40 }, (_, i) => <span class={foundCells.has(i) ? "is-found" : undefined}></span>)}
                </div>
              )}
              {c.id === "documents" && (
                <ul class="cap__tree">
                  <li>reports/</li>
                  <li>q3.docx</li>
                  <li>archive/</li>
                  <li class="is-found">notes.zip</li>
                </ul>
              )}
              {c.id === "watermarks" && (
                <ul class="cap__rows">
                  <li>C2PA manifest: valid</li>
                  <li class="is-found">watermark signal: detected</li>
                </ul>
              )}
            </div>
            <h3>{c.name}</h3>
            <p>{c.detail}</p>
            <a href={c.href}>Read the docs<span class="visually-hidden">: {c.name}</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap" id="use-cases" aria-labelledby="uses-h">
      <h2 id="uses-h">Where it fits</h2>
      <dl class="uses">
        {useCases.map((u) => (
          <div>
            <dt>{u.label}</dt>
            <dd>{u.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="closing wrap" aria-labelledby="closing-h">
      <h2 id="closing-h">Read the source before you trust it.</h2>
      <p class="section-lede">StegGuard is alpha software. Treat what it reports as evidence to check, not a final verdict.</p>
      <dl class="facts">
        <div><dt>License</dt><dd>Apache-2.0</dd></div>
        <div><dt>Dependencies</dt><dd>Python standard library only (Pillow is optional, for images)</dd></div>
        <div><dt>Network</dt><dd>Offline by default</dd></div>
        <div><dt>Tests</dt><dd><a href="https://github.com/stegguard/stegguard/actions">Run in CI on every push and pull request</a></dd></div>
      </dl>
      <p class="closing__actions">
        <a class="btn btn--solid" href="https://github.com/stegguard/stegguard">Read the source</a>
        <a class="btn" href="https://github.com/stegguard/stegguard/security/policy">Security policy</a>
      </p>
    </section>
  </main>

</Layout>
