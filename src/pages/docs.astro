---
import Layout from "../layouts/Layout.astro";
import { readDoc, parseMarkdownTable, extractCodeBlock } from "../lib/markdown";

const commands = [
  { name: "stegguard detect", detail: "Scans files or directories for hidden content.", where: "exit 0/1/2" },
  { name: "stegguard decode", detail: "Pulls out hidden payloads it recognizes in text, without changing the input.", where: "exit 0/2" },
  { name: "stegguard sanitize", detail: "Writes a cleaned copy and lists every change it made.", where: "exit 0/2" },
  { name: "stegguard watermark", detail: "Looks for watermark, fingerprint and provenance evidence, including C2PA.", where: "exit 0/2" },
];

const exitCodes = [
  { code: "0", meaning: "The scan finished and nothing was flagged." },
  { code: "1", meaning: "The scan finished and found something. Only detect uses this code." },
  { code: "2", meaning: "Bad arguments, or the scan could not finish (for example, a resource limit was hit)." },
];

// Resource limits and platform support are derived from the stegguard-oss docs at build time.
const limitsMd = readDoc("resource-limits.md");
const limits = parseMarkdownTable(limitsMd, "Resource Limits").map((r) => ({
  name: r["Limit"],
  value: r["Default"],
  purpose: r["Purpose"],
}));
const limitsExample = extractCodeBlock(limitsMd, "bash");

const platforms = parseMarkdownTable(readDoc("platform-support.md"), "Validation matrix").map((r) => ({
  platform: r["Platform"],
  python: r["Python"],
  status: r["Current evidence"],
}));
---

<Layout title="Docs · StegGuard" description="StegGuard CLI reference: commands, exit codes, resource limits and platform support.">
  <main>
    <section class="docs-hero">
      <h1>Commands, exit codes and limits.</h1>
      <p>
        The short reference. Detection categories, how sanitizing works and the report schema
        are covered in the <a href="https://github.com/stegguard/stegguard/tree/main/docs">full docs on GitHub</a>.
      </p>
    </section>

    <section class="spec-section">
      <h2>Commands</h2>
      <table class="spec-sheet tnum">
        <tbody>
          {commands.map((c) => (
            <tr>
              <th><code class="font-mono">{c.name}</code></th>
              <td>{c.detail}</td>
              <td class="muted">{c.where}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="spec-section">
      <h2>Exit codes</h2>
      <p class="docs-lede">Command names, long option names, JSON field meanings, and exit codes are public. They only change in a major release.</p>
      <table class="spec-sheet tnum">
        <tbody>
          {exitCodes.map((e) => (
            <tr>
              <th><code class="font-mono">{e.code}</code></th>
              <td>{e.meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="spec-section">
      <h2>Resource limits</h2>
      <p class="docs-lede">StegGuard treats every file it scans as untrusted. Each limit can be set with a <code class="font-mono">ScanLimits</code> object or the matching CLI flag.</p>
      <table class="spec-sheet tnum">
        <tbody>
          {limits.map((l) => (
            <tr>
              <th><code class="font-mono">{l.name}</code></th>
              <td>{l.purpose}</td>
              <td class="muted">{l.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <pre class="docs-code"><code>{limitsExample}</code></pre>
    </section>

    <section class="spec-section">
      <h2>Platform support</h2>
      <p class="docs-lede">The core is pure Python and targets CPython 3.12 to 3.14. Development happens on Linux x86-64. Other architectures have not been verified yet.</p>
      <table class="spec-sheet tnum">
        <tbody>
          {platforms.map((p) => (
            <tr>
              <th>{p.platform}</th>
              <td class="muted">{p.python}</td>
              <td>{p.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="closing">
      <div>
        <p>The compatibility policy, detection-quality notes and report schema are in the repo.</p>
        <a class="cta-link" href="https://github.com/stegguard/stegguard/tree/main/docs">Browse the docs on GitHub →</a>
      </div>
    </section>
  </main>
</Layout>
