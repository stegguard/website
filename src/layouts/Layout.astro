---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "StegGuard: find what's hiding in plain sight",
  description = "StegGuard finds invisible Unicode, homoglyphs, Trojan Source overrides, whitespace channels and watermark signals in code, documents, images and audio. Python standard library only, offline by default.",
} = Astro.props;

// Absolute URLs for social previews; Astro.site comes from astro.config.mjs.
const ogImage = new URL("/images/steg_banner.png", Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Runs before styles so dark-mode readers never see a white flash.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("theme"); } catch (e) {}
        var prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme =
          stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/steg_logo.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FAF9F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F1E1B" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="top">
      <div class="top__inner">
        <a href="/" class="brand">
          <img src="/images/steg_logo.png" alt="" width="24" height="24" />
          <span>StegGuard</span>
        </a>
        <nav class="top__nav" aria-label="Primary">
          <a href="/demo" aria-current={path === "/demo" ? "page" : undefined}>Demo</a>
          <a href="/docs" aria-current={path === "/docs" ? "page" : undefined}>Docs</a>
          <a class="top__gh" href="https://github.com/stegguard/stegguard">GitHub</a>
          <button class="theme" id="theme" type="button" aria-label="Dark mode" aria-pressed="false">
            <svg class="theme__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="theme__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="foot">
      <p>
        StegGuard is Apache-2.0 and in alpha, so check what it finds.
        <a href="https://github.com/stegguard/stegguard">Source</a> ·
        <a href="https://github.com/stegguard/stegguard/security/policy">Security policy</a>
      </p>
    </footer>

    <script>
      // Theme toggle: an explicit choice overrides the OS setting and sticks.
      const root = document.documentElement;
      const toggle = document.getElementById("theme");
      const sync = () => toggle?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
      toggle?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
        sync();
      });
      // Follow OS changes only while the visitor hasn't picked a theme.
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        if (!stored) {
          root.dataset.theme = e.matches ? "dark" : "light";
          sync();
        }
      });
      sync();

      // Copy buttons on code panels. The label change is the only feedback.
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          } catch {
            btn.textContent = "Copy failed";
            return;
          }
          btn.textContent = "Copied";
          setTimeout(() => (btn.textContent = "Copy"), 2000);
        });
      });

      // Highlight the TOC entry for the section in view (docs and demo pages).
      const tocLinks = new Map(
        Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc a")).map((a) => [a.hash.slice(1), a]),
      );
      const tocObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            tocLinks.forEach((a) => a.removeAttribute("aria-current"));
            tocLinks.get(entry.target.id)?.setAttribute("aria-current", "true");
          }
        },
        { rootMargin: "-15% 0px -70% 0px" },
      );
      tocLinks.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) tocObserver.observe(el);
      });
    </script>
  </body>
</html>
